# Copy to cluster.env (ignored by git) and adapt it to your cluster: every script here reads it.
# Run the scripts on the node that runs Kaptain: ../deploy-policy.sh builds the decider image
# there with Docker and imports it into that node's containerd.
# The workers are the nodes labelled kaptain.io/experiment-node=true, the label kexp.py uses.

# How to run kubectl against the cluster. It must accept stdin (hence -i with docker exec).
# Ours runs K3s in a Docker container on the master:
#   KUBECTL="docker exec -i kaptain-k3s kubectl --server=https://10.50.0.1:6443"
KUBECTL="kubectl"

# How ../deploy-policy.sh runs ctr on this node, to import the decider image. It needs root, and
# sudo must not ask for a password: every run deploys, and run-arms.sh runs for hours.
# K3s: "sudo k3s ctr". Another containerd: "sudo ctr -n k8s.io". Ours: "docker exec -i kaptain-k3s ctr".
KAPTAIN_CTR="sudo k3s ctr"
# The name of this node, as in kubectl get nodes: kaptain-scheduler and kaptain-decider run on it.
KAPTAIN_MASTER="master"

# The DRS network server (net-server/), outside Kubernetes: IPv4:port, reachable from the workers.
# The same address as NET_SERVER_BIND and NET_SERVER_PORT when you start it.
DRS_NET_SERVER="10.50.0.1:5301"

# What the DRS monitor measures on each worker: the first interface, and the first disk, of each
# list that the worker has. The interface is the one the net pods' traffic goes through, to the
# network server (ip -o -4 addr on a worker); the disk is the one holding the pods' emptyDir
# volumes (df /var/lib/kubelet on a worker, then lsblk). apply-monitors.sh prints what each worker picked.
MONITOR_IFACES="eth0,ens18,enp0s3,wlan0"
MONITOR_DISKS="sda,vda,nvme0n1,mmcblk0"

# Where the runs are written. Default: reproduction-drs/results.
# RESULTS=/path/to/results
