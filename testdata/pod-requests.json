{
  "comment": "Effective pod requests. The Go plugin calls PodRequests from k8s.io/kubernetes/pkg/api/v1/resource; bridge/snapshot.py ports the same algorithm. Ordinary init containers contribute a maximum, restartable init containers (sidecars) add up and also count towards later init containers, and pod overhead is added last.",
  "cases": [
    {
      "name": "plain containers add up",
      "pod": {"spec": {"containers": [
        {"name": "a", "resources": {"requests": {"cpu": "500m", "memory": "256Mi"}}},
        {"name": "b", "resources": {"requests": {"cpu": "250m", "memory": "128Mi"}}}
      ]}},
      "expected": {"millicpu": 750, "memory_bytes": 402653184}
    },
    {
      "name": "an ordinary init container is a maximum, not a sum",
      "pod": {"spec": {
        "containers": [{"name": "a", "resources": {"requests": {"cpu": "500m", "memory": "256Mi"}}}],
        "initContainers": [{"name": "setup", "resources": {"requests": {"cpu": "2", "memory": "1Gi"}}}]
      }},
      "expected": {"millicpu": 2000, "memory_bytes": 1073741824}
    },
    {
      "name": "a smaller init container does not lower the total",
      "pod": {"spec": {
        "containers": [{"name": "a", "resources": {"requests": {"cpu": "500m", "memory": "256Mi"}}}],
        "initContainers": [{"name": "setup", "resources": {"requests": {"cpu": "100m", "memory": "64Mi"}}}]
      }},
      "expected": {"millicpu": 500, "memory_bytes": 268435456}
    },
    {
      "name": "a restartable init container (sidecar) adds up",
      "pod": {"spec": {
        "containers": [{"name": "a", "resources": {"requests": {"cpu": "500m", "memory": "256Mi"}}}],
        "initContainers": [{"name": "proxy", "restartPolicy": "Always", "resources": {"requests": {"cpu": "100m", "memory": "64Mi"}}}]
      }},
      "expected": {"millicpu": 600, "memory_bytes": 335544320}
    },
    {
      "name": "a sidecar also counts towards a later init container",
      "pod": {"spec": {
        "containers": [{"name": "a", "resources": {"requests": {"cpu": "200m", "memory": "64Mi"}}}],
        "initContainers": [
          {"name": "proxy", "restartPolicy": "Always", "resources": {"requests": {"cpu": "100m", "memory": "64Mi"}}},
          {"name": "setup", "resources": {"requests": {"cpu": "1", "memory": "512Mi"}}}
        ]
      }},
      "expected": {"millicpu": 1100, "memory_bytes": 603979776}
    },
    {
      "name": "pod overhead is added last",
      "pod": {"spec": {
        "containers": [{"name": "a", "resources": {"requests": {"cpu": "500m", "memory": "256Mi"}}}],
        "overhead": {"cpu": "50m", "memory": "16Mi"}
      }},
      "expected": {"millicpu": 550, "memory_bytes": 285212672}
    },
    {
      "name": "no requests at all",
      "pod": {"spec": {"containers": [{"name": "a"}]}},
      "expected": {"millicpu": 0, "memory_bytes": 0}
    }
  ]
}
