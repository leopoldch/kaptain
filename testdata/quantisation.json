{
  "comment": "Score quantisation must be identical in both integrations. The third case is the one a review caught: with a finer scale on one side only, 1960 and 2000 tie in the extender but not in the plugin, so the two paths place the pod differently.",
  "cases": [
    {
      "raw": {
        "a": 1000.0,
        "b": 1960.0,
        "c": 2000.0
      },
      "expected": {
        "a": 0,
        "b": 9,
        "c": 10
      },
      "winner": "c"
    },
    {
      "raw": {
        "a": 0.0,
        "b": 0.5,
        "c": 1.0
      },
      "expected": {
        "a": 0,
        "b": 5,
        "c": 10
      },
      "winner": "c"
    },
    {
      "raw": {
        "a": 1.0,
        "b": 1.0
      },
      "expected": {
        "a": 10,
        "b": 10
      },
      "winner": "a"
    },
    {
      "raw": {
        "a": -1.0,
        "b": 0.0,
        "c": -2.0
      },
      "expected": {
        "a": 5,
        "b": 10,
        "c": 0
      },
      "winner": "b"
    },
    {
      "raw": {
        "a": 0.0001,
        "b": 0.0002
      },
      "expected": {
        "a": 0,
        "b": 10
      },
      "winner": "b"
    }
  ]
}
