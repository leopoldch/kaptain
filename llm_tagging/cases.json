 {
  "id": "c12",
  "source": "busybox: write 256 MiB of random data, then gzip it",
  "pod": {
   "apiVersion": "v1",
   "kind": "Pod",
   "spec": {
    "restartPolicy": "Never",
    "activeDeadlineSeconds": 3600,
    "automountServiceAccountToken": false,
    "securityContext": {
     "runAsNonRoot": true,
     "runAsUser": 65534,
     "runAsGroup": 65534,
     "seccompProfile": {
      "type": "RuntimeDefault"
     }
    },
    "containers": [
     {
      "name": "work",
      "image": "busybox@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662",
      "command": [
       "sh",
       "-c",
       "head -c 268435456 /dev/urandom > /tmp/in && gzip -c /tmp/in > /tmp/in.gz"
      ],
      "resources": {
       "requests": {
        "cpu": "500m",
        "memory": "64Mi"
       },
       "limits": {
        "cpu": "500m",
        "memory": "64Mi"
       }
      },
      "securityContext": {
       "allowPrivilegeEscalation": false,
       "capabilities": {
        "drop": [
         "ALL"
        ]
       }
      }
     }
    ]
   }
  }
